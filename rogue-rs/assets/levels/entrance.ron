// A hand-authored "entrance hall" — demonstrates a fixed/verbatim level.
//
// Legend (built-in): '.' floor, '#' corridor, '|''-' wall, '+' door,
//   '>' stairs down, '^' trap, '@' player start, '$' gold, '*' item,
//   'A'..'Z' monster by glyph. Custom mappings can be added in `legend`.
Fixed((
    rows: [
        "                                                                                ",
        "  ----------------                          --------------                      ",
        "  |..............|                          |............|                      ",
        "  |.....@........|        ------------       |....*.......|                      ",
        "  |..............+########+..........+#######+............|                      ",
        "  |......$.......|        |....K.....|       |.......>....|                      ",
        "  |..............|        |..........|       |............|                      ",
        "  ----------------        |....^.....|       --------------                      ",
        "                          ------+-----                                           ",
        "                               #                                                ",
        "                               #                                                ",
        "                       --------+-------                                          ",
        "                       |.............|                                          ",
        "                       |...B.....H...|                                          ",
        "                       |.............|                                          ",
        "                       ---------------                                          ",
    ],
    legend: [],
    dark: false,
))

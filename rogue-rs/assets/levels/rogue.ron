// A special level where the corridors themselves spell "ROGUE".
// Each letter is traced by walkable # passages at 2× pixel-font scale.
// Walk the word, collect the loot, fight the guards, and find > to descend.
//
// Letter layout (10 wide × 14 tall each, 2-col gaps):
//   R  cols 11-20    O  cols 23-32    G  cols 35-44
//   U  cols 47-56    E  cols 59-68
//
// R: full top/middle bars, right bump, step-diagonal leg
// O: closed rectangle (walk the perimeter)
// G: like O but open upper-right, inward ledge at middle-right
// U: two arms, closed at the bottom
// E: left spine + three horizontal bars (top / middle / bottom)
Fixed((
    rows: [
        "                                                                                ",
        "                                                                                ",
        "                                                                                ",
        "                                                                                ",
        "                                                                                ",
        "           ##########  ##########  ##########  ##      ##  ##########           ",
        "           ##########  ##########  ##########  ##      ##  ##########           ",
        "           ##      ##  ##      ##  ##          ##      ##  ##                   ",
        "           ##      ##  ##      ##  ##          ##      ##  ##                   ",
        "           ##      ##  ##      ##  ##          ##      ##  ##                   ",
        "           ##      ##  ##      ##  ##          ##      ##  ##                   ",
        "           ##########  ##      ##  ##  ######  ##      ##  ########             ",
        "           ##########  ##      ##  ##  ######  ##      ##  ########             ",
        "           ########    ##      ##  ##      ##  ##      ##  ##                   ",
        "           ########    ##      ##  ##      ##  ##      ##  ##                   ",
        "           ##  ######  ##      ##  ##      ##  ##      ##  ##                   ",
        "           ##  ######  ##      ##  ##      ##  ##      ##  ##                   ",
        "           ##    ####  ##########  ##########  ##########  ##########           ",
        "           ##    ####  ##########  ##########  ##########  ##########           ",
        "  ####@#######$#####*#######K#########$#####*#######B##########$##*######>####  ",
        "                                                                                ",
        "                                                                                ",
        "                                                                                ",
        "                                                                                ",
    ],
    legend: [],
    dark: false,
))
